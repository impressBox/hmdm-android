# /etc/hmdm-runner/runner.env — configuration for the hmdm-android runner pool on the build server.
# install.sh copies this template on first run; keep the real file root-owned, mode 0600.
# Read by ci/runner/hmdm-runner.sh (one process per slot), install.sh and build-image.sh.

# ---- where the runners register -----------------------------------------------------------
GITHUB_OWNER=impressBox
GITHUB_REPO=hmdm-android
# repo: the runners serve hmdm-android only (runner group is always 1 = Default).
RUNNER_SCOPE=repo
#RUNNER_GROUP_ID=1

# ---- GitHub credential: set ONE of the two ------------------------------------------------
# a) Fine-grained personal access token, in a file (0600), not in this file:
#    resource owner impressBox, repository hmdm-android only,
#    repository permission "Administration: Read and write" (what generate-jitconfig needs).
GITHUB_PAT_FILE=/etc/hmdm-runner/github-pat
# b) GitHub App (not tied to a person). Same permission, app installed on hmdm-android;
#    the slot mints a 1-hour installation token per registration.
#GITHUB_APP_ID=
#GITHUB_APP_INSTALLATION_ID=
#GITHUB_APP_KEY_FILE=/etc/hmdm-runner/github-app.pem

# ---- slots ----------------------------------------------------------------------------------
# install.sh enables hmdm-runner@ci-1..CI_RUNNERS and hmdm-runner@build-1..BUILD_RUNNERS.
# Launcher builds are few: one ci slot for pull requests, one build slot for signed APKs. An idle slot is a
# waiting runner process in a container, nearly free.
CI_RUNNERS=1
BUILD_RUNNERS=1

# ---- labels (self-hosted,linux,x64 are always added) ------------------------------------------
# Workflows route jobs by these (docs/ci-runners.md). ci/runner/check-wiring.sh reads this file:
# change a label here and in the workflows together.
CI_LABELS=hmdm-ci
BUILD_LABELS=hmdm-build

# ---- image ------------------------------------------------------------------------------------
IMAGE=hmdm-runner:current
# Extra `docker run` arguments for every slot, e.g. "--memory 6g --cpus 4", so a launcher build
# cannot starve the other pools' builds on the same host (player, manage, gateway, writer).
# Default: --memory 6g --cpus 4 (a Gradle build takes what it gets), and --dns as for the writer pool:
# on the build server (10.0.0.200) containers otherwise inherit the host's upstream
# resolvers (67.207.67.x), which do not answer from the Docker bridge. Every lookup then waits
# 5 s for the fallback, and Gradle's dependency downloads crawl.
# 192.168.122.1 is the VM's own resolver. On another host, drop it or use that host's resolver.
EXTRA_DOCKER_ARGS="--dns 192.168.122.1 --memory 6g --cpus 4"
# Seconds a running job gets to wind down when a slot is stopped.
STOP_TIMEOUT=30
